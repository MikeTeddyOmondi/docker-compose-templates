# Pinned to the version already running locally, so `up` pulls nothing new.
# The gateway subcommand used for JWT auth needs 0.4.x — see the plan doc.
URSULA_VERSION=0.3.0

# Host port. Only bind beyond localhost once something is authenticating in
# front of it; Ursula has no auth of its own.
URSULA_PORT=4437

# ./ursula/single.toml   one durable node (default)
# ./ursula/cluster.toml  three voters, with --profile raft
URSULA_CONFIG=./ursula/single.toml

RUSTLOG=log
